{
  "name": "@m11s-io/s3-upload-proxy",
  "version": "0.1.3",
  "description": "HTTP-to-S3 upload proxy — accepts multipart file uploads and stores them in any S3-compatible store",
  "main": "dist/index.js",
  "bin": {
    "s3-upload-proxy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "s3",
    "minio",
    "upload",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m11s-io/js"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "cors": "^2",
    "express": "^5",
    "multer": "^1"
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/multer": "^1",
    "tsup": "^8",
    "typescript": "^5"
  }
}
