{
  "name": "@m11s-io/s3-upload-proxy",
  "version": "0.1.3",
  "description": "HTTP upload proxy for S3-compatible storage, including Amazon S3, Cloudflare R2, and MinIO",
  "main": "dist/index.js",
  "bin": {
    "s3-upload-proxy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun run build && bun test test/*.test.mjs"
  },
  "keywords": [
    "s3",
    "r2",
    "cloudflare",
    "minio",
    "upload",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m11s-io/js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1067.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "multer": "2.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "tsup": "9.0.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
