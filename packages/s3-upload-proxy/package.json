{
  "name": "@m11s-io/s3-upload-proxy",
  "version": "0.1.3",
  "description": "HTTP-to-S3 upload proxy — accepts multipart file uploads and stores them in any S3-compatible store",
  "main": "dist/index.js",
  "bin": {
    "s3-upload-proxy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun run build && bun test test/*.test.mjs"
  },
  "keywords": [
    "s3",
    "minio",
    "upload",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m11s-io/js"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1067.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "multer": "1.4.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "1.4.13",
    "tsup": "9.0.0",
    "typescript": "7.0.2"
  }
}
